# Configure these values in Render. This template is not loaded automatically.
DATABASE_URL=postgres://ph_runtime:CHANGE_ME@localhost:5432/ph_votaciones
JWT_SECRET=set-a-unique-secret-with-at-least-32-bytes
JWT_ISSUER=https://identity.example.com
JWT_AUDIENCE=ph-votaciones-api
# Required for Vite during local development. The deployed single service accepts its own origin automatically.
CORS_ORIGINS=http://localhost:5173
PORT=3000
PG_POOL_MAX=20
PG_SSL=false
